# ===========================================
# Daily News Collector 配置文件
# ===========================================

# 企业微信 Webhook（可选，用于推送通知）
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# 定时任务配置（默认每天8点执行）
CRON_SCHEDULE=0 8 * * *

# 新闻输出目录（默认 ./news_reports）
NEWS_OUTPUT_DIR=./news_reports

# ===========================================
# AI 分析配置（推荐配置，大幅提升内容质量）
# ===========================================

# AI 服务提供商: siliconflow | deepseek | openai | custom
AI_PROVIDER=siliconflow

# AI API Key（必填，从对应平台获取）
# 硅基流动(免费推荐): https://siliconflow.cn/
# DeepSeek: https://platform.deepseek.com/
# OpenAI: https://platform.openai.com/
AI_API_KEY=your_api_key_here

# AI API 基础 URL
# 硅基流动: https://api.siliconflow.cn/v1
# DeepSeek: https://api.deepseek.com
# OpenAI: https://api.openai.com
AI_BASE_URL=https://api.siliconflow.cn/v1

# AI 模型选择
# 硅基流动免费模型: deepseek-ai/DeepSeek-V3, Qwen/Qwen2.5-72B-Instruct
# DeepSeek: deepseek-chat, deepseek-coder
# OpenAI: gpt-4, gpt-3.5-turbo
AI_MODEL=deepseek-ai/DeepSeek-V3

# AI 参数配置（可选）
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
